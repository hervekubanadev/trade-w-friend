# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# (Optional) Supabase Service Role Key — for admin operations only
# Never expose this in client-side code
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App Configuration
APP_NAME=TradeWFriend
APP_ENV=development          # development | staging | production
DEFAULT_CURRENCY=RWF         # Rwandan Franc
DEFAULT_LOCALE=en-RW         # English (Rwanda)

# Feature Flags
ENABLE_KIOSK_MODE=true
ENABLE_DARK_MODE=true
ENABLE_SENTRY=false          # Error tracking

# (Future) Mobile Money API Keys
# MTN_MOMO_API_KEY=
# MTN_MOMO_API_SECRET=
# MTN_MOMO_ENVIRONMENT=sandbox  # sandbox | production
# AIRTEL_MONEY_API_KEY=
# AIRTEL_MONEY_API_SECRET=
